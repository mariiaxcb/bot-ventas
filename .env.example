# Configuración del bot de ventas (WhatsApp)
# Copia este archivo a .env y ajusta los valores según tu entorno.

# URL del backend (API REST + WebSocket)
BACKEND_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080/api

# Credenciales de autenticación contra el backend
# IMPORTANTE: estas deben coincidir con un administrador existente y activo en la DB del backend.
API_EMAIL=mariiaxcb@gmail.com
API_PASSWORD=Megaman123$

# Puerto de la API interna del bot (para que el panel del vendedor controle la sesión de WhatsApp)
BOT_API_PORT=3111

# Tiempos de notificación de reserva (en milisegundos).
# La reserva dura 3 minutos (igual que RESERVATION_TTL_MINUTES del backend):
# recordatorio a 1 min, último aviso a 2 min y pérdida/cancelación a 3 min.
FIRST_NOTIFICATION_MS=60000
SECOND_NOTIFICATION_MS=120000
RESERVATION_LOST_MS=180000
ORDER_CANCEL_MS=180000
